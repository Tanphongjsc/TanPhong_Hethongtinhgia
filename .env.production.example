# Example only. Supply real values via the process manager/secret store.
# config.production never auto-loads .env or this file.
APP_ENV=production
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-generator
DJANGO_ALLOWED_HOSTS=costing.internal.example
# Keep the existing Supabase SESSION pooler endpoint, not the transaction pooler.
DB_HOST=replace-with-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
APP_MODE=single_company
# Legacy internal FK compatibility only; normally resolved from the sole active row.
# DEFAULT_ORGANIZATION_ID=
# Choose explicitly: private_http OR https_proxy. This does not configure networking.
APP_TRANSPORT=private_http
# Only for https_proxy: exact TCP peer IP of the TLS gateway, never '*'.
APP_TRUSTED_PROXY=
# Normally empty for same-origin. If needed, exact origins separated by commas.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_HSTS_SECONDS=0
APP_HTTPS_VERIFIED=False
LOG_LEVEL=INFO
APP_BIND=127.0.0.1
APP_PORT=8000
APP_THREADS=4
# Idle connection timeout, NOT a Costing/Pricing execution deadline.
APP_CHANNEL_TIMEOUT=120
# Optional absolute release-specific path; default <release>/staticfiles.
# DJANGO_STATIC_ROOT=
