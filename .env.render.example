# Reference only. Enter these in Render Dashboard > Environment; never source/commit secrets.
# Render automatically supplies RENDER=true, RENDER_EXTERNAL_HOSTNAME and PORT.
APP_ENV=production
DJANGO_SETTINGS_MODULE=config.production
APP_TRANSPORT=render_https
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-new-production-secret-of-at-least-50-random-characters
DATABASE_URL=postgresql://database-user:encoded-password@session-pooler-host:5432/postgres?sslmode=require
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
APP_MODE=single_company
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
# The exact Render hostname and its HTTPS CSRF origin are added automatically.
# Optional additional exact hosts/origins only; no wildcard, and no ${VAR} expansion.
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# HSTS stays off until the actual HTTPS deployment has been verified.
DJANGO_SECURE_HSTS_SECONDS=0
APP_HTTPS_VERIFIED=False
# No APP_TRUSTED_PROXY: Render's managed ingress is the transport boundary.
# No user, auth/API key, service_role, organization selector or credentials in UI.
