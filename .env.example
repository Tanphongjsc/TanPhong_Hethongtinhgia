APP_ENV=development
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=postgres
DB_USER=your-costing-database-user
DB_PASSWORD=replace-me
DB_HOST=your-supabase-postgres-host
DB_PORT=5432
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
APP_MODE=single_company
# Required only when several organizations are active; choose an existing active ID.
# DEFAULT_ORGANIZATION_ID=
